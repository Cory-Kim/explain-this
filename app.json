{
  "expo": {
    "name": "explain-this",
    "slug": "explain-this",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "explainthis",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/images/icon.png"
    },

    "android": {
      "package": "com.lazywolfexplainthis.explainthis",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#123B63"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to preview in Explain This.",
          "cameraPermission": "Allow Explain This to use the camera to explain your photos.",
          "microphonePermission": false
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "a335ac85-b671-4f06-bcb1-5492bf488d17"
      }
    },

    "owner": "lazywolf-explain-this"
  }
}